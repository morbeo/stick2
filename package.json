{
  "name": "stick2",
  "private": true,
  "scripts": {
    "build-info": "node tools/build-info.js",
    "itch": "node tools/itch.js",
    "mcp": "node tools/mcp.js",
    "itch:push": "npm test && node tools/itch.js --push",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' tests/*.test.js",
    "coverage:browser": "COVERAGE=1 node tests/browser.js",
    "pretest": "node tools/build-info.js",
    "test": "node --test tests/*.test.js",
    "test:update": "UPDATE=1 node --test tests/*.test.js",
    "test:browser": "node tests/browser.js",
    "test:matrix": "MATRIX=full node --test tests/matrix.test.js",
    "test:all": "npm test && npm run test:browser"
  }
}
