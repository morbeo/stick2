{
  "name": "stick2",
  "private": true,
  "scripts": {
    "build-info": "node tools/dev/build-info.js",
    "embed-presets": "node tools/dev/embed-presets.js",
    "itch": "node tools/itch/itch.js",
    "itch:assets": "node tools/itch/itch-assets.js",
    "mcp": "node tools/mcp/mcp.js",
    "discord-bot": "node tools/discord/discord-bot.js",
    "discord-stickers": "node tools/discord/discord-stickers.js",
    "itch:push": "npm test && node tools/itch/itch.js --push",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' tests/unit/*.test.js",
    "coverage:check": "node tools/dev/coverage-check.js",
    "lint:src": "node tools/dev/no-test-hooks.js",
    "chars:sync": "node tools/dev/char-scripts.js",
    "char:add": "node tools/dev/char-add.js",
    "coverage:browser": "COVERAGE=1 node tests/browser/browser.js",
    "pretest": "node tools/dev/build-info.js",
    "test": "node --test tests/unit/*.test.js",
    "test:update": "UPDATE=1 node --test tests/unit/*.test.js",
    "test:browser": "node tests/browser/browser.js",
    "test:matrix": "MATRIX=full node --test tests/unit/matrix.test.js",
    "test:all": "npm test && npm run test:browser",
    "server": "npm --prefix server start",
    "pretest:server": "npm --prefix server install --no-audit --no-fund",
    "test:server": "npm --prefix server test",
    "test:server-browser": "npm --prefix server install --no-audit --no-fund && node tools/dev/server-test.js",
    "test:netplay": "node tools/dev/netplay-test.js",
    "test:editor": "node tests/browser/editor-flow.js"
  },
  "dependencies": {
    "discord.js": "^14.16.0"
  }
}
